#include <stdio.h>
int main() {
int a[12], n, i, j, sum = 0;
int min, max, second, found = 0;
int peaks = 0, curr = 1, longest = 1;
int k, shift, temp, d, count = 0;
float avg;
/* Read valid N */
do {
printf("Enter N (5 to 12): ");
scanf("%d", &n);
} while (n < 5 || n > 12);
/* Read valid readings */
for (i = 0; i < n; i++) {
do {
printf("Enter reading %d (0 to 1000): ", i + 1);
scanf("%d", &a[i]);
} while (a[i] < 0 || a[i] > 1000);
}
/* 1. Display original readings */
printf("\nOriginal readings: ");
for (i = 0; i < n; i++)
printf("%d ", a[i]);
/* 2. Sum, average, minimum and maximum */
min = max = a[0];
for (i = 0; i < n; i++) {
sum += a[i];
if (a[i] < min) min = a[i];
if (a[i] > max) max = a[i];
}
avg = (float)sum / n;
printf("\nSum = %d", sum);
printf("\nAverage = %.2f", avg);
printf("\nMinimum = %d", min);
printf("\nMaximum = %d", max);
/* 3. Second-largest distinct value */
for (i = 0; i < n; i++) {
if (a[i] < max && (!found || a[i] > second)) {
second = a[i];
found = 1;
}
}
if (found)
printf("\nSecond-largest distinct value = %d", second);
else
printf("\nNo second-largest distinct value exists.");
/* 4. Count local peaks */
for (i = 1; i < n - 1; i++) {
if (a[i] > a[i - 1] && a[i] > a[i + 1])
peaks++;
}
printf("\nNumber of local peaks = %d", peaks);
/* 5. Longest strictly increasing contiguous run */
for (i = 1; i < n; i++) {
if (a[i] > a[i - 1]) {
curr++;
if (curr > longest)
longest = curr;
} else {
curr = 1;
}
}
printf("\nLongest increasing run = %d", longest);
/* 6. Rotate array in place */
printf("\nEnter K (positive = right, negative = left): ");
scanf("%d", &k);
shift = ((k % n) + n) % n;
for (j = 0; j < shift; j++) {
temp = a[n - 1];
for (i = n - 1; i > 0; i--)
a[i] = a[i - 1];
a[0] = temp;
}
printf("Rotated readings: ");
for (i = 0; i < n; i++);
printf("%d ", a[i]);
/* 7. Divisibility using last two registration digits */
printf("\nEnter last two digits of registration number (0-99): ");
scanf("%d", &k);
if (k < 0 || k > 99) {
printf("Invalid registration digits.");
return 0;
}
d = (k % 9) + 1;
for (i = 0; i < n; i++) {
if (a[i] % d == 0)
count++;
}
printf("\nD = %d", d);
printf("\nValues divisible by D = %d\n", count);
return 0;
}
